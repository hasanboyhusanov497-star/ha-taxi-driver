<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f5c400"><title>HA TAXI — Haydovchi</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{margin:0;font-family:Arial,sans-serif;background:#0d0d0d;color:#fff}button{border:0;cursor:pointer;font:inherit}.app{max-width:520px;min-height:100vh;margin:auto;background:#171717}header{padding:20px;background:#202020;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #333}.logo{font-size:26px;font-weight:900}.logo span{color:#f5c400}.city{color:#aaa;font-size:13px;margin-top:4px}.online-status{padding:8px 12px;border-radius:20px;font-size:12px;font-weight:bold;background:#333;color:#aaa}.online-status.active{background:#123d20;color:#46e477}.content{padding:18px}.driver-card{display:flex;align-items:center;gap:14px;background:#242424;padding:18px;border-radius:18px;margin-bottom:15px}.avatar{width:62px;height:62px;border-radius:50%;background:#f5c400;display:flex;align-items:center;justify-content:center;font-size:32px}.driver-info h2{margin:0;font-size:20px}.driver-info p{margin:6px 0 0;color:#aaa;font-size:14px}.online-button{width:100%;padding:18px;border-radius:15px;background:#f5c400;color:#111;font-size:17px;font-weight:900;margin-bottom:18px}.online-button.active{background:#28c95b;color:white}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.stat{background:#242424;border-radius:14px;padding:15px 8px;text-align:center}.stat strong{display:block;font-size:19px;margin-bottom:5px}.stat small{color:#888;font-size:11px}.panel{background:#242424;border-radius:18px;padding:20px;text-align:center}.panel h2{margin:8px 0}.muted{color:#999;line-height:1.5}.route,.customer,.detail{background:#1b1b1b;border-radius:14px;padding:15px;margin:12px 0;text-align:left;overflow-wrap:anywhere}.order-details{display:grid;grid-template-columns:1fr 1fr;gap:10px}.detail{background:#303030;margin:0}.detail small{display:block;color:#888;margin-bottom:6px}.actions{display:grid;grid-template-columns:1fr 1.4fr;gap:10px;margin-top:15px}.actions button,.main-btn{padding:16px;border-radius:13px;font-weight:900}.reject{background:#3a2020;color:#ff7777}.accept{background:#28c95b;color:white}.main-btn{width:100%;background:#f5c400;color:#111;margin-top:12px}.hidden{display:none!important}.location-box{background:#242424;border-radius:16px;padding:16px;margin-top:18px}.location-box button{width:100%;padding:13px;border-radius:12px;background:#333;color:white;margin-top:10px}.location-text{color:#aaa;font-size:13px;line-height:1.5;overflow-wrap:anywhere}footer{padding:25px 18px;text-align:center;color:#666;font-size:12px}@media(max-width:380px){.content{padding:13px}.logo{font-size:22px}}
</style></head><body><div class="app">
<header><div><div class="logo">🚕 <span>HA TAXI</span></div><div class="city">📍 Shahrixon</div></div><div id="status" class="online-status">OFFLINE</div></header>
<div class="content">
<div class="driver-card"><div class="avatar">👨‍✈️</div><div class="driver-info"><h2>HA TAXI Haydovchi</h2><p>⭐ 5.0 · Shahrixon</p></div></div>
<button id="onlineBtn" class="online-button">🔴 ISHGA CHIQISH</button>
<div class="stats"><div class="stat"><strong id="todayTrips">0</strong><small>Bugungi safar</small></div><div class="stat"><strong id="todayMoney">0</strong><small>Bugungi daromad</small></div><div class="stat"><strong>5.0 ⭐</strong><small>Reyting</small></div></div>
<div id="waiting" class="panel"><div style="font-size:55px">🚕</div><h2>Haydovchi rejimi</h2><p class="muted">Haqiqiy buyurtmalarni olish uchun ISHGA CHIQISH tugmasini bosing.</p></div>
<div id="order" class="panel hidden"><h2>🔔 YANGI BUYURTMA</h2><div class="customer">👤 HA TAXI mijozi</div><div class="route">🟢 <b>Qayerdan:</b><br><span id="from">—</span><br><br>🔴 <b>Qayerga:</b><br><span id="to">—</span></div><div class="order-details"><div class="detail"><small>Masofa</small><strong id="distance">—</strong></div><div class="detail"><small>Narx</small><strong id="price">—</strong></div></div><div class="actions"><button id="reject" class="reject">❌ RAD ETISH</button><button id="accept" class="accept">✅ QABUL QILISH</button></div></div>
<div id="trip" class="panel hidden"><div style="font-size:55px">🚕</div><h2 id="tripTitle">Buyurtma qabul qilindi</h2><div class="route">🟢 <span id="tripFrom"></span><br><br>🔴 <span id="tripTo"></span><br><br>💰 <b id="tripPrice"></b></div><button id="start" class="main-btn">🚗 SAFARNI BOSHLASH</button><button id="finish" class="main-btn hidden">🏁 SAFARNI YAKUNLASH</button></div>
<div class="location-box"><b>📍 Haydovchi joylashuvi</b><div id="locationText" class="location-text">Joylashuv aniqlanmagan.</div><button id="gpsBtn">📍 GPS JOYLASHUVIMNI ANIQLASH</button></div>
</div><footer>🚕 HA TAXI • Shahrixon<br>Haydovchilar uchun rasmiy panel</footer></div>
<script>
/* Project URL va publishable key Supabase Dashboard'dan aynan ko'chirilishi kerak. */
const SUPABASE_URL="https://elgebypfchqbypolhkyr.supabase.co";
const SUPABASE_KEY="sb_publishable_Cyn-1p_MWjqjNPSSnCoB1A_knye9MPr";
const $=id=>document.getElementById(id);
let driver=null,online=false,currentOrder=null,activeTrip=null,poll=null;
let trips=Number(localStorage.getItem("haTaxiTrips")||0),money=Number(localStorage.getItem("haTaxiMoney")||0);
$("todayTrips").textContent=trips;$("todayMoney").textContent=money.toLocaleString("uz-UZ");
const moneyText=n=>Number(n||0).toLocaleString("uz-UZ")+" so'm";
function show(id){["waiting","order","trip"].forEach(x=>$(x).classList.toggle("hidden",x!==id))}
async function api(path,options={}){
 const res=await fetch(SUPABASE_URL+"/rest/v1/"+path,{...options,headers:{apikey:SUPABASE_KEY,Authorization:"Bearer "+SUPABASE_KEY,"Content-Type":"application/json",Prefer:"return=representation",...(options.headers||{})}});
 const text=await res.text();if(!res.ok)throw Error("Supabase "+res.status+": "+text);return text?JSON.parse(text):[];
}
async function loadDriver(){
 try{const rows=await api("drivers?select=*&order=created_at.asc&limit=1");if(!rows.length){console.error("drivers jadvalida haydovchi yozuvi yo'q");return}driver=rows[0];}
 catch(e){console.error(e);alert("Supabase haydovchini yuklay olmadi. URL/key yoki RLS siyosatini tekshirish kerak.");}
}
function renderOnline(){ $("status").textContent=online?"🟢 ONLINE":"OFFLINE";$("status").classList.toggle("active",online);$("onlineBtn").textContent=online?"🟢 ISHLAYAPMAN — ONLINE":"🔴 ISHGA CHIQISH";$("onlineBtn").classList.toggle("active",online);}
$("onlineBtn").onclick=async()=>{
 if(!driver){await loadDriver();if(!driver){alert("Supabase drivers jadvalida haydovchi topilmadi.");return}}
 const next=!online;
 try{const rows=await api("drivers?id=eq."+encodeURIComponent(driver.id),{method:"PATCH",body:JSON.stringify({online:next})});if(!rows.length)throw Error("Haydovchi yangilanmadi");online=next;driver.online=next;renderOnline();
 if(poll)clearInterval(poll);poll=null;if(online){await checkOrders();poll=setInterval(checkOrders,3000)}else{currentOrder=null;show("waiting")}}
 catch(e){console.error(e);alert("Online holati saqlanmadi. Supabase URL/key, drivers jadvali va UPDATE RLS siyosatini tekshiring.")}
};
async function checkOrders(){
 if(!online||!driver||currentOrder||activeTrip)return;
 try{const rows=await api("orders?select=id,customer_id,driver_id,from_address,to_address,price,distance_km,status,created_at&status=eq.pending&driver_id=is.null&order=created_at.asc&limit=1");
 if(!rows.length){show("waiting");return}currentOrder=rows[0];$("from").textContent=currentOrder.from_address||"Manzil kiritilmagan";$("to").textContent=currentOrder.to_address||"Manzil kiritilmagan";$("distance").textContent=Number(currentOrder.distance_km||0)+" km";$("price").textContent=moneyText(currentOrder.price);show("order");if(navigator.vibrate)navigator.vibrate([250,120,250]);}
 catch(e){console.error("Buyurtmalarni olish xatosi:",e)}
}
$("reject").onclick=()=>{currentOrder=null;show("waiting");checkOrders()};
$("accept").onclick=async()=>{
 if(!currentOrder||!driver)return;const chosen=currentOrder;
 try{const rows=await api("orders?id=eq."+encodeURIComponent(chosen.id)+"&status=eq.pending&driver_id=is.null",{method:"PATCH",body:JSON.stringify({driver_id:driver.id,driver_name:driver.name||"HA TAXI Haydovchi",status:"accepted",accepted_at:new Date().toISOString()})});
 if(!rows.length){alert("Buyurtmani boshqa haydovchi qabul qilgan yoki u endi mavjud emas.");currentOrder=null;show("waiting");return}
 activeTrip=rows[0];currentOrder=null;$("tripTitle").textContent="Buyurtma qabul qilindi";$("tripFrom").textContent=activeTrip.from_address||"—";$("tripTo").textContent=activeTrip.to_address||"—";$("tripPrice").textContent=moneyText(activeTrip.price);$("start").classList.remove("hidden");$("finish").classList.add("hidden");show("trip");}
 catch(e){console.error(e);alert("Buyurtma qabul qilinmadi. RLS siyosati va orders ustunlarini tekshiring.")}
};
$("start").onclick=async()=>{
 if(!activeTrip)return;try{const rows=await api("orders?id=eq."+encodeURIComponent(activeTrip.id)+"&driver_id=eq."+encodeURIComponent(driver.id)+"&status=eq.accepted",{method:"PATCH",body:JSON.stringify({status:"started",started_at:new Date().toISOString()})});if(!rows.length)throw Error("Holat yangilanmadi");activeTrip=rows[0];$("tripTitle").textContent="Safar boshlandi";$("start").classList.add("hidden");$("finish").classList.remove("hidden");}
 catch(e){console.error(e);alert("Safarni boshlashda xato. RLS siyosati yoki started_at ustunini tekshiring.")}
};
$("finish").onclick=async()=>{
 if(!activeTrip)return;try{const rows=await api("orders?id=eq."+encodeURIComponent(activeTrip.id)+"&driver_id=eq."+encodeURIComponent(driver.id)+"&status=eq.started",{method:"PATCH",body:JSON.stringify({status:"completed",finished_at:new Date().toISOString()})});if(!rows.length)throw Error("Holat yangilanmadi");
 trips++;money+=Number(activeTrip.price||0);localStorage.setItem("haTaxiTrips",trips);localStorage.setItem("haTaxiMoney",money);$("todayTrips").textContent=trips;$("todayMoney").textContent=money.toLocaleString("uz-UZ");alert("Safar yakunlandi! Daromad: "+moneyText(activeTrip.price));activeTrip=null;show("waiting");checkOrders();}
 catch(e){console.error(e);alert("Safarni yakunlashda xato. RLS siyosati yoki finished_at ustunini tekshiring.")}
};
$("gpsBtn").onclick=()=>{const t=$("locationText");if(!navigator.geolocation){t.textContent="Brauzer GPS'ni qo'llamaydi.";return}t.textContent="Joylashuv aniqlanmoqda...";navigator.geolocation.getCurrentPosition(async p=>{t.textContent="Latitude: "+p.coords.latitude.toFixed(6)+", Longitude: "+p.coords.longitude.toFixed(6);if(driver){try{await api("drivers?id=eq."+encodeURIComponent(driver.id),{method:"PATCH",body:JSON.stringify({lat:p.coords.latitude,lng:p.coords.longitude})})}catch(e){console.error("GPS bazaga yozilmadi:",e)}}},()=>t.textContent="GPS ruxsati berilmadi. Brauzerda Location ruxsatini yoqing.",{enableHighAccuracy:true,timeout:10000})};
loadDriver();
</script></body></html>
